#
# Node B: Seeed XIAO ESP32-S3 + Seeed XIAO WM6108 (MM6108), S1G relay root AP.

CONFIG_IDF_TARGET="esp32s3"

# ---- Board: Seeed XIAO ESP32S3 + Seeed XIAO WM6108 -------------------------------------------
# Same as esp-halow halow/configs/sdkconfig.defaults.seeed_xiao_esp32s3-seeed_xiao_mm6108.
CONFIG_MM_RESET_N=1
CONFIG_MM_WAKE=2
CONFIG_MM_BUSY=5
CONFIG_MM_SPI_SCK=7
CONFIG_MM_SPI_MOSI=9
CONFIG_MM_SPI_MISO=8
CONFIG_MM_SPI_CS=4
CONFIG_MM_SPI_IRQ=3
# Host <-> WM6108 SPI: drive the peripheral registers directly (esp-halow fast path) at 40 MHz,
# the highest exact ESP SPI clock below the MM6108's 50 MHz limit.
CONFIG_MM_SPI_FAST_PATH=y
CONFIG_MM_SPI_CLOCK_MHZ=40
CONFIG_MM_BCF_FILE="bcf_fgh100mhaamd.bin"
CONFIG_MM_CHIP_MM6108=y

# ---- Wi-Fi HaLow -----------------------------------------------------------------------------
CONFIG_HALOW_COUNTRY_CODE="AU"
# Same AU channel list on every node (the mm-iot-sdk default on the relay).
CONFIG_WIFI_MORSE_AU_CHANNELISATION_REVMF=y
CONFIG_HALOW_AP_MODE=y
CONFIG_HALOW_RELAY_MODE=y

# Packet memory as in the SDK's relay_mode application: 32 + 2 * MAX_STAS (4) blocks per
# direction. CONFIG_MMPKTMEM_TX_MGMT_POOL_N_BLOCKS defaults to 4 with relay mode.
CONFIG_MMPKTMEM_TX_POOL_N_BLOCKS=40
CONFIG_MMPKTMEM_RX_POOL_N_BLOCKS=40

# ---- System ----------------------------------------------------------------------------------
CONFIG_FREERTOS_HZ=1000
# Full CPU speed: the SPI transport to the WM6108 is CPU-bound.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
# The XIAO's USB-C port is the ESP32-S3 USB Serial/JTAG controller.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# ---- lwIP (as in the esp-halow softap example) -----------------------------------------------
CONFIG_LWIP_NETIF_STATUS_CALLBACK=y
CONFIG_LWIP_NETIF_LINK_CALLBACK=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_IPV6_DHCP6=y
CONFIG_LWIP_IRAM_OPTIMIZATION=y
CONFIG_LWIP_TCP_MSS=1460
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=8760
CONFIG_LWIP_TCP_WND_DEFAULT=14600
CONFIG_LWIP_TCP_RECVMBOX_SIZE=10
CONFIG_LWIP_UDP_RECVMBOX_SIZE=10
# Static ARP entry support (lwIP ETHARP_SUPPORT_STATIC_ENTRIES) for CONFIG_LAB_B_STATIC_ARP.
# No DHCP server runs on the HaLow netif.
CONFIG_LWIP_DHCPS=y
CONFIG_LWIP_DHCPS_STATIC_ENTRIES=y
