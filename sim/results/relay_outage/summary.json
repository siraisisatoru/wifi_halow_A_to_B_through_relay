  "scenario": {
    "name": "relay_outage",
    "title": "A-relay-B, relay-B link black hole 15 s (association held)",
    "description": "The relay's uplink to node B is black-holed (100 % loss both ways) from t=20 s for 15 s while every interface and association stays up. This models an outage shorter than beacon-loss detection, NOT the relay losing the root: on the EKH05 that also takes the relay's own IP down and, after the 10 s recovery timeout, tears down the relay AP and node A's association (see sim/README.md, Hardware differences). Checks UDP loss accounting and TCP stall detection, backoff and reconnect.",
    "topology": "relay",
    "duration_s": 90
  },
  "model": {
    "medium": {
      "_comment": "S1G 2 MHz, 1 SS, MCS5, long GI: 5.2 Mbit/s PHY. frame_overhead_us = S1G short preamble 240 + SIFS 160 + NDP ACK 240 + AIFS[BE] 316 + mean backoff 7.5 slots x 52 = 390. mac_overhead_bytes = 4-address QoS MAC header 32 + LLC/SNAP 8 + CCMP 16 + FCS 4.",
